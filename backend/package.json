{
  "name": "microbevision-ai",
  "version": "1.0.0",
  "description": "Computer Vision System for Automated Microbial Colony Counting, CFU Analysis, and Zone-wise Colony Distribution Analysis of Medical Appliance Samples",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --forceExit --testTimeout=15000",
    "test:verbose": "jest --forceExit --testTimeout=15000 --verbose"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageProvider": "v8"
  },
  "keywords": [
    "microbiology",
    "colony-counter",
    "computer-vision",
    "cfu-analysis",
    "medical-laboratory"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "bullmq": "^5.80.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.1.0",
    "he": "^1.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "pm2": "^7.0.3",
    "supertest": "^7.2.2"
  }
}
